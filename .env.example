# Copy to .env for local dev. For production values (Tiger Data URL, live token),
# keep a .env.production next to it: both are gitignored.

# Postgres. Local docker-compose by default.
DATABASE_URL=postgresql://mumble:mumble@localhost:5433/mumble

# Ollama (local GPU in dev, CPU on GitHub Actions at night)
OLLAMA_URL=http://localhost:11434
MUMBLE_MODEL=gemma4:e2b-it-qat
MUMBLE_EMBED_MODEL=embeddinggemma

# faster-whisper model size: tiny, base, small
WHISPER_MODEL=small

# Shared secret the phone sends with every request (single-user app), 24+ characters
MUMBLE_TOKEN=change-me

# Your timezone, used to turn "Tuesday at 10" into a real date
MUMBLE_TZ=America/Toronto


# Optional: the Sunday weekly review by Ultramarine. Unset = no review, nothing leaves.
PAPERINSTRUMENTS_API_KEY=
