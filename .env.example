# Postgres. Local docker-compose by default; paste your Tiger Cloud service URL in production.
DATABASE_URL=postgresql://mumble:mumble@localhost:5433/mumble

# Ollama (local GPU in dev, CPU on the DigitalOcean Droplet in production)
OLLAMA_URL=http://localhost:11434
MUMBLE_MODEL=gemma4:e2b-it-qat
MUMBLE_EMBED_MODEL=embeddinggemma

# faster-whisper model size: tiny, base, small
WHISPER_MODEL=small

# Shared secret the phone sends with every request (single-user app)
MUMBLE_TOKEN=change-me

# Your timezone, used to turn "Tuesday at 10" into a real date
MUMBLE_TZ=America/Toronto

